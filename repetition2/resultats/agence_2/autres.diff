+"use client";
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+export function AssistantButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#1d4ed8", mode: "light", background: "#f6f7f9", surface: "#ffffff", text: "#1b1f24", mutedText: "#6b7280", border: "#e2e5ea", danger: "#b91c1c" }}
+    />
+  );
+}
