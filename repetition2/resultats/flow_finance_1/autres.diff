index 0000000..7b40938
--- /dev/null
+++ b/src/components/features/vak-assistant.tsx
@@ -0,0 +1,27 @@
+/**
+ * @file vak-assistant.tsx
+ * @description Bouton flottant de l'assistant IA vak, monté sur tous les écrans du dashboard.
+ */
+
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useLocale } from "next-intl";
+import { useRouter } from "@/i18n/navigation";
+import { vak } from "@/lib/vak";
+
+export function VakAssistant() {
+  const router = useRouter();
+  const locale = useLocale();
+
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      lang={locale}
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
