diff --git a/components/layout/floating-assistant.tsx b/components/layout/floating-assistant.tsx
new file mode 100644
index 0000000..0bb92c5
--- /dev/null
+++ b/components/layout/floating-assistant.tsx
@@ -0,0 +1,18 @@
+"use client";
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+/** Floating assistant button, mounted once in the authenticated shell so it appears on every app screen. */
+export function FloatingAssistant() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
