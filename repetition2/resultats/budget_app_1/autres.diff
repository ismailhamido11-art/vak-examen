diff --git a/src/components/layout/vak-launcher.tsx b/src/components/layout/vak-launcher.tsx
new file mode 100644
index 0000000..f33d67f
--- /dev/null
+++ b/src/components/layout/vak-launcher.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+
+import { vak } from "@/lib/vak";
+
+export function VakLauncher() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/sign-in")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
