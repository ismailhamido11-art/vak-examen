--- /dev/null
+++ b/src/components/AssistantButton.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { usePathname, useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+// Bouton flottant sur tous les écrans ; la page /assistant a déjà le chat en plein écran.
+export default function AssistantButton() {
+  const router = useRouter();
+  const pathname = usePathname();
+  if (pathname === "/assistant") return null;
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
