new file mode 100644
index 0000000..8e2812c
--- /dev/null
+++ b/components/layout/AssistantLauncher/index.jsx
@@ -0,0 +1,18 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+export default function AssistantLauncher() {
+  const router = useRouter();
+
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      theme={{ accent: "#0056F3", mode: "dark" }}
+    />
+  );
+}
