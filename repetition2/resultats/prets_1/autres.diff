diff --git a/src/lib/assistant-button.tsx b/src/lib/assistant-button.tsx
new file mode 100644
index 0000000..7f859b1
--- /dev/null
+++ b/src/lib/assistant-button.tsx
@@ -0,0 +1,37 @@
+import { router, useSegments } from 'expo-router';
+import { Pressable, StyleSheet, Text } from 'react-native';
+
+// Bouton flottant vers l'assistant, présent sur tous les écrans (sauf la connexion et l'assistant lui-même).
+export function AssistantButton() {
+  const segments = useSegments() as string[];
+  if (segments[0] === 'login' || segments[0] === 'assistant') return null;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel="Ouvrir l'assistant"
+      onPress={() => router.push('/assistant')}
+      style={styles.fab}>
+      <Text style={styles.text}>IA</Text>
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  fab: {
+    position: 'absolute',
+    right: 20,
+    bottom: 28,
+    width: 56,
+    height: 56,
+    borderRadius: 28,
+    backgroundColor: '#208AEF',
+    alignItems: 'center',
+    justifyContent: 'center',
+    elevation: 6,
+    shadowColor: '#000',
+    shadowOpacity: 0.25,
+    shadowRadius: 4,
+    shadowOffset: { width: 0, height: 2 },
+  },
+  text: { color: '#fff', fontWeight: '700', fontSize: 16 },
+});
