+++ b/components/VakButton.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+// Bouton flottant de l'assistant, monté dans le layout : présent sur tous les écrans.
+export function VakButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#9f1239", mode: "light", background: "#fafaf9", text: "#1c1917", mutedText: "#78716c" }}
+    />
+  );
+}
