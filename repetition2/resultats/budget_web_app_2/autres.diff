new file mode 100644
index 0000000..39edb57
--- /dev/null
+++ b/components/layout/assistant-button.tsx
@@ -0,0 +1,20 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+
+import { vak } from "@/lib/vak";
+
+/** Bouton flottant de l'assistant vak, monté dans le layout de l'app (tous les écrans connectés). */
+export function AssistantButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
