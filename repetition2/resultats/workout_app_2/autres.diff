diff --git a/src/app/vak-button.tsx b/src/app/vak-button.tsx
new file mode 100644
index 0000000..2f30387
--- /dev/null
+++ b/src/app/vak-button.tsx
@@ -0,0 +1,18 @@
+"use client";
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+// Floating assistant button, mounted once in the root layout so it shows on every screen.
+export function VakButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#18181b", mode: "system" }}
+    />
+  );
+}
