diff --git a/components/AssistantFab.tsx b/components/AssistantFab.tsx
new file mode 100644
index 0000000..30e6d1a
--- /dev/null
+++ b/components/AssistantFab.tsx
@@ -0,0 +1,38 @@
+import { Ionicons } from "@expo/vector-icons";
+import { router, usePathname } from "expo-router";
+import { Pressable, StyleSheet } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+export function AssistantFab() {
+  const pathname = usePathname();
+  const insets = useSafeAreaInsets();
+  if (pathname === "/assistant" || pathname === "/settings") return null;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel="Open the assistant"
+      onPress={() => router.push("/assistant")}
+      style={[styles.fab, { bottom: 20 + insets.bottom }]}
+    >
+      <Ionicons name="chatbubble-ellipses" size={26} color="#ffffff" />
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  fab: {
+    position: "absolute",
+    right: 20,
+    width: 56,
+    height: 56,
+    borderRadius: 28,
+    backgroundColor: "#2563EB",
+    alignItems: "center",
+    justifyContent: "center",
+    elevation: 6,
+    shadowColor: "#000",
+    shadowOpacity: 0.3,
+    shadowRadius: 6,
+    shadowOffset: { width: 0, height: 3 },
+  },
+});
