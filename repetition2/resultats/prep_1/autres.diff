@@ -0,0 +1,256 @@
+-- vak 0004 — message compté au premier morceau du modèle, effacement complet du journal d'actions (0.22.0). Copiée par la
+-- commande init de sa CLI ; NE JAMAIS MODIFIER (empreinte vérifiée). Mêmes règles que vak 0001 : public, préfixe vak_,
+-- security invoker, search_path vide, revoke puis grant explicites, aucun SQL dynamique, aucune table nouvelle.
+-- vak_0001 à vak_0003 restent intactes ; vak_claim_action est remplacée à signature égale : un serveur 0.20 fonctionne ici.
+-- Garde sur la version (et non sur les fonctions) : après un retour à 0.20 puis son « vak remove », les fonctions restées
+-- seules sont remplacées à la réinstallation (create or replace).
+-- Attente des verrous bornée (db push, une transaction) : derrière une transaction longue sur vak_usage ou vak_actions,
+-- la migration abandonne (55P03), sans rien appliquer, et se relance ; les tours, eux, ne restent pas bloqués derrière.
+do $$ begin
+  perform pg_catalog.set_config('lock_timeout', '3s', true);
+  if to_regprocedure('public.vak_save_messages_if(text, text, jsonb, text[], text)') is null then
+    raise exception 'vak : migration vak_0003 absente. Appliquez les migrations dans l''ordre, puis lancez « node node_modules/@vak/agent/bin/vak.mjs doctor --db » depuis la racine du projet.';
+  end if;
+  if public.vak_schema_version() >= 4 then
+    raise exception 'vak : migration vak_0004 déjà appliquée (vak_schema_version() = %). Ne la réappliquez pas : lancez « node node_modules/@vak/agent/bin/vak.mjs doctor --db » depuis la racine du projet.', public.vak_schema_version();
+  end if;
+end $$;
+
+-- 1. Quota. Un message est réservé « en attente » (pending) avant le modèle, sous le verrou de vak_reserve_turn : il
+-- compte tant qu'il vit (6 minutes), pour que des tours simultanés ne dépassent jamais la limite. Le serveur le confirme
+-- au premier morceau du fournisseur, AVANT d'en laisser sortir quoi que ce soit ; confirmé, il compte pour toujours.
+-- Jamais confirmé (tour arrêté avant toute étape du modèle), il cesse de compter. Aucune transition ne fait baisser le
+-- compte : l'utilisateur ne peut que confirmer ses propres réservations (UPDATE pending → false seulement), jamais
+-- l'inverse, ni changer une date, ni supprimer une ligne (vak_usage reste sans DELETE). Lignes d'avant et lignes d'un
+-- serveur 0.20 : pending = false, comptées comme avant.
+alter table public.vak_usage add column pending boolean not null default false;
+-- 'answer' : empreinte d'une validation répondue (ci-dessous) ; 'eval' reste permis pour les lignes anciennes.
+alter table public.vak_usage drop constraint vak_usage_kind_check;
+alter table public.vak_usage add constraint vak_usage_kind_check
+  check (kind in ('message', 'chat', 'resume', 'extract', 'eval', 'task', 'answer'));
+alter table public.vak_usage add constraint vak_usage_pending_check check (not pending or kind = 'message');
+
+create policy vak_usage_update on public.vak_usage for update to authenticated
+  using ((select auth.uid()) = user_id and pending)
+  with check ((select auth.uid()) = user_id and not pending);
+grant update (pending) on public.vak_usage to authenticated;
+-- Garde : la seule mise à jour de vak_usage est la confirmation d'une réservation (pending vrai → faux), toutes les
+-- autres colonnes inchangées, quels que soient les droits de colonne : un « grant all » de l'app (VAK102 ✗) ne permet
+-- jamais de redater, requalifier ni déplacer une réservation pour qu'elle ne compte plus. Même garde sur vak_actions
+-- (plus bas) : une ligne du journal ne change que par son solde (status, result).
+create or replace function public.vak_usage_confirm_only() returns trigger
+language plpgsql security invoker set search_path = '' as $$
+begin
+  if tg_table_name = 'vak_actions' then
+    if (new.id, new.user_id, new.agent_id, new.chat_id, new.approval_id, new.tool, new.input, new.created_at)
+       is distinct from (old.id, old.user_id, old.agent_id, old.chat_id, old.approval_id, old.tool, old.input, old.created_at) then
+      raise exception 'vak_actions : seul le solde d''une action est permis' using errcode = '42501';
+    end if;
+    return new;
+  end if;
+  if not (old.pending and not new.pending)
+     or (new.id, new.user_id, new.agent_id, new.kind, new.model, new.input_tokens, new.output_tokens, new.cached_input_tokens,
+         new.chat_id, new.created_at)
+        is distinct from (old.id, old.user_id, old.agent_id, old.kind, old.model, old.input_tokens, old.output_tokens,
+         old.cached_input_tokens, old.chat_id, old.created_at) then
+    raise exception 'vak_usage : seule la confirmation d''une réservation est permise' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger vak_usage_confirm_only before update on public.vak_usage
+  for each row execute function public.vak_usage_confirm_only();
+
+-- Réservation (remplace vak_reserve_turn pour un serveur 0.22, même verrou) : messages comptés = confirmés + en attente
+-- de moins de 6 minutes ; tokens de tous les tours. Refus : rien d'écrit. Sinon, message en attente et son id.
+create or replace function public.vak_reserve_message(
+  p_agent_id text, p_chat_id text, p_since timestamptz, p_count_message boolean,
+  p_max_messages integer default null, p_max_tokens bigint default null
+)
+returns table (allowed boolean, messages integer, tokens bigint, reservation uuid)
+language plpgsql volatile security invoker set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_messages integer;
+  v_tokens bigint;
+  v_reservation uuid;
+begin
+  if v_user_id is null then
+    raise exception 'vak_reserve_message : utilisateur non authentifié' using errcode = '42501';
+  end if;
+  perform pg_advisory_xact_lock(hashtextextended('vak_reserve_turn:' || v_user_id::text || ':' || p_agent_id, 0));
+  select count(*) filter (where u.kind = 'message' and (not u.pending or u.created_at > now() - interval '6 minutes'))::integer,
+         coalesce(sum(u.input_tokens + u.output_tokens), 0)::bigint
+    into v_messages, v_tokens
+    from public.vak_usage u
+   where u.user_id = v_user_id and u.agent_id = p_agent_id and u.created_at >= p_since;
+  if (p_count_message and p_max_messages is not null and v_messages >= p_max_messages)
+     or (p_max_tokens is not null and v_tokens >= p_max_tokens) then
+    return query select false, v_messages, v_tokens, null::uuid;
+    return;
+  end if;
+  if p_count_message then
+    insert into public.vak_usage (agent_id, kind, model, chat_id, pending)
+    values (p_agent_id, 'message', '', p_chat_id, true)
+    returning id into v_reservation;
+  end if;
+  return query select true, v_messages, v_tokens, v_reservation;
+end $$;
+
+-- Confirmation : true si la réservation compte désormais (confirmée ici, ou déjà) ; false si elle est inconnue, d'un autre
+-- utilisateur, ou vieille de 5 minutes ou plus (le serveur arrête alors le tour sans rien laisser sortir). Sans verrou
+-- consultatif : l'utilisateur ne peut pas la retarder en saturant vak_reserve_turn. Marge d'une minute avec la durée de
+-- vie comptée par la réservation (6 minutes), bien au-delà du délai d'une requête du serveur (10 secondes).
+create or replace function public.vak_confirm_message(p_reservation uuid)
+returns boolean
+language plpgsql volatile security invoker set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    raise exception 'vak_confirm_message : utilisateur non authentifié' using errcode = '42501';
+  end if;
+  update public.vak_usage u set pending = false
+   where u.id = p_reservation and u.user_id = v_user_id and u.kind = 'message' and u.pending
+     and u.created_at > now() - interval '5 minutes';
+  return found or exists (
+    select 1 from public.vak_usage u
+     where u.id = p_reservation and u.user_id = v_user_id and u.kind = 'message' and not u.pending);
+end $$;
+
+-- 2. Journal. Chaque validation répondue (acceptée ou refusée) laisse dans vak_usage une empreinte (kind 'answer', SHA-256
+-- de son approval_id dans chat_id), ajout seul, jamais effacée sauf avec le compte : un journal effacé ne rend jamais une
+-- validation rejouable, même depuis un historique sauvegardé puis réinséré. Deux réponses simultanées se départagent sur
+-- l'index unique de l'empreinte ; une ligne du journal ne s'efface qu'avec sa conversation, et jamais sans empreinte.
+create unique index vak_usage_answer_idx on public.vak_usage (user_id, chat_id) where kind = 'answer';
+
+-- Empreinte d'une validation : SHA-256 hexadécimal de son approval_id (jamais l'identifiant en clair dans l'usage).
+create or replace function public.vak_answer_key(p_approval_id text)
+returns text
+language sql immutable security invoker set search_path = '' as $$
+  select pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(p_approval_id, 'UTF8')), 'hex')
+$$;
+
+-- Ligne du journal effaçable par l'appelant : sa conversation n'existe plus (aucune carte à régler ni à régénérer), et
+-- sa validation, s'il y en a une, a son empreinte. Fonction plutôt que sous-requêtes dans la politique : aucune
+-- dépendance de vak_actions envers vak_chats ni vak_usage (le sql/remove.sql de 0.20, qui supprime ces tables avant
+-- vak_actions, reste utilisable après un retour arrière).
+create or replace function public.vak_erasable(p_approval_id text, p_chat_id text)
+returns boolean
+language sql stable security invoker set search_path = '' as $$
+  select not exists (select 1 from public.vak_chats c where c.id = p_chat_id and c.user_id = (select auth.uid()))
+     and (p_approval_id is null or exists (
+           select 1 from public.vak_usage u
+            where u.user_id = (select auth.uid()) and u.kind = 'answer' and u.chat_id = public.vak_answer_key(p_approval_id)))
+$$;
+
+-- Validations répondues avant vak_0004 (serveur 0.21 ou plus ancien) : leur empreinte, posée une fois.
+insert into public.vak_usage (user_id, agent_id, kind, model, chat_id, created_at)
+select a.user_id, a.agent_id, 'answer', '', public.vak_answer_key(a.approval_id), a.created_at
+  from public.vak_actions a where a.approval_id is not null
+on conflict (user_id, chat_id) where kind = 'answer' do nothing;
+-- Garde du journal (fonction de la garde de vak_usage) : une ligne ne se modifie que pour son solde (status, result),
+-- quels que soient les droits de colonne : un « grant all » de l'app ne la rend jamais rejouable ni effaçable avant
+-- sa conversation.
+create trigger vak_actions_settle_only before update on public.vak_actions
+  for each row execute function public.vak_usage_confirm_only();
+
+create policy vak_actions_delete on public.vak_actions for delete to authenticated
+  using ((select auth.uid()) = user_id and public.vak_erasable(approval_id, chat_id));
+grant delete on public.vak_actions to authenticated;
+
+-- Verrou d'idempotence (remplace celui de vak_0001, même signature et mêmes droits) : empreinte d'abord. Déjà répondue →
+-- claimed = false et le statut du journal, ou 'erased' si le journal a été effacé depuis.
+create or replace function public.vak_claim_action(p_agent_id text, p_chat_id text, p_approval_id text, p_tool text, p_input jsonb)
+returns table (claimed boolean, status text)
+language plpgsql security invoker set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    raise exception 'vak_claim_action : utilisateur non authentifié' using errcode = '42501';
+  end if;
+  if coalesce(p_approval_id, '') = '' then
+    raise exception 'vak_claim_action : approval_id requis' using errcode = '22023';
+  end if;
+  insert into public.vak_usage (agent_id, kind, model, chat_id)
+  values (p_agent_id, 'answer', '', public.vak_answer_key(p_approval_id))
+  on conflict (user_id, chat_id) where kind = 'answer' do nothing;
+  if found then
+    insert into public.vak_actions (agent_id, chat_id, approval_id, tool, input, status)
+    values (p_agent_id, p_chat_id, p_approval_id, p_tool, p_input, 'claimed')
+    on conflict (user_id, approval_id) do nothing;
+    if found then
+      return query select true, 'claimed'::text;
+      return;
+    end if;
+  end if;
+  return query select false, coalesce(
+    (select a.status from public.vak_actions a where a.user_id = v_user_id and a.approval_id = p_approval_id), 'erased');
+end $$;
+
+-- Refus sous le même verrou (la première réponse gagne) : recorded = false si la validation a déjà une réponse.
+create or replace function public.vak_deny_action(p_agent_id text, p_chat_id text, p_approval_id text, p_tool text, p_input jsonb)
+returns boolean
+language plpgsql volatile security invoker set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    raise exception 'vak_deny_action : utilisateur non authentifié' using errcode = '42501';
+  end if;
+  if coalesce(p_approval_id, '') = '' then
+    raise exception 'vak_deny_action : approval_id requis' using errcode = '22023';
+  end if;
+  insert into public.vak_usage (agent_id, kind, model, chat_id)
+  values (p_agent_id, 'answer', '', public.vak_answer_key(p_approval_id))
+  on conflict (user_id, chat_id) where kind = 'answer' do nothing;
+  if not found then
+    return false;
+  end if;
+  insert into public.vak_actions (agent_id, chat_id, approval_id, tool, input, status)
+  values (p_agent_id, p_chat_id, p_approval_id, p_tool, p_input, 'denied')
+  on conflict (user_id, approval_id) do nothing;
+  return found;
+end $$;
+
+-- « Effacer mes données » (DELETE data) de l'utilisateur pour un agent, en UNE transaction : empreinte de chaque
+-- validation répondue du journal (lignes d'avant vak_0004 ou d'un serveur 0.20 comprises), puis avis, conversations
+-- (messages en cascade), journal, souvenirs, rappels, accord. L'usage reste (compteur du quota, empreintes) : il ne part
+-- qu'avec le compte. Une ligne du journal écrite pendant l'effacement par un serveur 0.20 (refus sans empreinte) reste.
+create or replace function public.vak_erase_data(p_agent_id text)
+returns void
+language plpgsql volatile security invoker set search_path = '' as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    raise exception 'vak_erase_data : utilisateur non authentifié' using errcode = '42501';
+  end if;
+  -- Deux effacements simultanés (deux appareils) se suivent : jamais d'interblocage, quel que soit l'ordre des lignes.
+  perform pg_advisory_xact_lock(hashtextextended('vak_erase_data:' || v_user_id::text || ':' || p_agent_id, 0));
+  insert into public.vak_usage (agent_id, kind, model, chat_id)
+  select p_agent_id, 'answer', '', public.vak_answer_key(a.approval_id)
+    from public.vak_actions a
+   where a.user_id = v_user_id and a.agent_id = p_agent_id and a.approval_id is not null
+   order by a.approval_id
+  on conflict (user_id, chat_id) where kind = 'answer' do nothing;
+  delete from public.vak_feedback f where f.user_id = v_user_id and f.agent_id = p_agent_id;
+  delete from public.vak_chats c where c.user_id = v_user_id and c.agent_id = p_agent_id;
+  delete from public.vak_actions a where a.user_id = v_user_id and a.agent_id = p_agent_id;
+  delete from public.vak_memories m where m.user_id = v_user_id and m.agent_id = p_agent_id;
+  delete from public.vak_reminders r where r.user_id = v_user_id and r.agent_id = p_agent_id;
+  delete from public.vak_consents c where c.user_id = v_user_id and c.agent_id = p_agent_id;
+end $$;
+
+revoke all on function public.vak_reserve_message(text, text, timestamptz, boolean, integer, bigint),
+  public.vak_confirm_message(uuid), public.vak_answer_key(text), public.vak_erasable(text, text),
+  public.vak_deny_action(text, text, text, text, jsonb), public.vak_erase_data(text), public.vak_usage_confirm_only()
+  from public, anon, authenticated, service_role;
+grant execute on function public.vak_reserve_message(text, text, timestamptz, boolean, integer, bigint),
+  public.vak_confirm_message(uuid), public.vak_answer_key(text), public.vak_erasable(text, text),
+  public.vak_deny_action(text, text, text, text, jsonb), public.vak_erase_data(text)
+  to authenticated;
+
+-- Version de schéma : droits de vak_0001 conservés (create or replace ne les change pas).
+create or replace function public.vak_schema_version() returns integer
+language sql immutable security invoker set search_path = '' as $$ select 4 $$;
