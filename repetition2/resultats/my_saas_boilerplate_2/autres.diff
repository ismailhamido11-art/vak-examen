diff --git a/components/layout/vak-button.tsx b/components/layout/vak-button.tsx
new file mode 100644
index 0000000..debbe09
--- /dev/null
+++ b/components/layout/vak-button.tsx
@@ -0,0 +1,21 @@
+'use client';
+
+import { AgentButton } from '@vak/agent/web';
+import { useRouter } from 'next/navigation';
+import { useAuth } from '@/lib/auth/auth-context';
+import { vak } from '@/lib/vak';
+
+export function VakButton() {
+  const router = useRouter();
+  const { user } = useAuth();
+  if (!user) return null;
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push('/sign-in')}
+      theme={{ accent: '#0F766E', mode: 'system' }}
+    />
+  );
+}
