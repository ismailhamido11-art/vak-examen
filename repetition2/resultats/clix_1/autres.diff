index 0000000..64e2dbd
--- /dev/null
+++ b/components/layout/AssistantLauncher/AssistantLauncher.module.css
@@ -0,0 +1,15 @@
+/* Mobile : au-dessus de la barre CTA collante et de la zone de sécurité. */
+.launcher:global(.vak-launcher) {
+  right: var(--container-padding, 1rem);
+  bottom: calc(5rem + env(safe-area-inset-bottom));
+}
+
+.launcher :global(.vak-fab) {
+  min-height: 2.75rem;
+}
+
+@media (min-width: 48rem) {
+  .launcher:global(.vak-launcher) {
+    bottom: 1.25rem;
+  }
+}
