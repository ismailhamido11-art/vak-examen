diff --git a/components/layout/vak-button.tsx b/components/layout/vak-button.tsx
new file mode 100644
index 0000000..9f5c234
--- /dev/null
+++ b/components/layout/vak-button.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+/** Floating assistant button, mounted once in the authenticated shell so it appears on every app screen. */
+export function VakButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
