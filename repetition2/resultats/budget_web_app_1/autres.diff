diff --git a/components/layout/assistant-button.tsx b/components/layout/assistant-button.tsx
new file mode 100644
index 0000000..4d9a74f
--- /dev/null
+++ b/components/layout/assistant-button.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+
+import { vak } from "@/lib/vak";
+
+/** Bouton flottant de l'assistant vak, monté une fois dans le layout de l'app (tous les écrans connectés). */
+export function AssistantButton() {
+  const router = useRouter();
+
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
