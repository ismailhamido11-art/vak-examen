--- /dev/null
+++ b/src/components/AssistantButton.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useRouter } from "next/navigation";
+import { vak } from "@/lib/vak";
+
+// Bouton flottant de l'assistant, monté dans le layout : présent sur tous les écrans.
+export function AssistantButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0b5394", mode: "light" }}
+    />
+  );
+}
