diff --git a/src/components/assistant/VakLauncher.tsx b/src/components/assistant/VakLauncher.tsx
new file mode 100644
index 0000000..04d3743
--- /dev/null
+++ b/src/components/assistant/VakLauncher.tsx
@@ -0,0 +1,39 @@
+'use client';
+
+import { AgentButton } from '@vak/agent/web';
+import { useLocale } from 'next-intl';
+import { usePathname, useRouter } from 'next/navigation';
+import { vak } from '@/lib/vak';
+
+// Screens shown to signed-out visitors: the assistant needs a session, so no button there.
+const PUBLIC_PREFIXES = [
+  '/login',
+  '/signup',
+  '/forgot-password',
+  '/reset-password',
+  '/verify-email',
+  '/auth',
+  '/join',
+  '/offline',
+  '/assistant',
+];
+
+/** Floating assistant button, mounted once in the root layout. */
+export function VakLauncher() {
+  const pathname = usePathname() ?? '/';
+  const router = useRouter();
+  const lang = useLocale();
+
+  if (pathname === '/' || PUBLIC_PREFIXES.some((p) => pathname.startsWith(p))) return null;
+
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      lang={lang}
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push('/login')}
+      theme={{ accent: '#0F766E', mode: 'system' }}
+    />
+  );
+}
