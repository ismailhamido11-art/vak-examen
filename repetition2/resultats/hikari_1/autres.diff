new file mode 100644
index 0000000..4998ef2
--- /dev/null
+++ b/components/vak-button.tsx
@@ -0,0 +1,17 @@
+'use client';
+import { AgentButton } from '@vak/agent/web';
+import { useRouter } from 'next/navigation';
+import { vak } from '@/lib/vak';
+
+export function VakButton() {
+  const router = useRouter();
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push('/signin')}
+      theme={{ accent: '#0F766E', mode: 'system' }}
+    />
+  );
+}
