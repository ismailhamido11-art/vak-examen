diff --git a/src/components/assistant-button.tsx b/src/components/assistant-button.tsx
new file mode 100644
index 0000000..13c6d99
--- /dev/null
+++ b/src/components/assistant-button.tsx
@@ -0,0 +1,41 @@
+import { router, usePathname } from 'expo-router';
+import { Pressable, StyleSheet } from 'react-native';
+
+import { ThemedText } from '@/components/themed-text';
+
+const HIDDEN_ON = ['/assistant', '/reglages', '/login'];
+
+/** Bouton flottant : ouvre l'assistant depuis tous les écrans connectés. */
+export function AssistantButton() {
+  const pathname = usePathname();
+  if (HIDDEN_ON.includes(pathname)) return null;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel="Ouvrir l'assistant"
+      onPress={() => router.push('/assistant')}
+      style={styles.fab}>
+      <ThemedText type="smallBold" style={styles.label}>
+        Assistant
+      </ThemedText>
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  fab: {
+    position: 'absolute',
+    right: 16,
+    bottom: 24,
+    paddingHorizontal: 18,
+    paddingVertical: 14,
+    borderRadius: 28,
+    backgroundColor: '#208AEF',
+    elevation: 6,
+    shadowColor: '#000',
+    shadowOpacity: 0.25,
+    shadowRadius: 6,
+    shadowOffset: { width: 0, height: 3 },
+  },
+  label: { color: '#ffffff' },
+});
