diff --git a/src/components/features/assistant-button.tsx b/src/components/features/assistant-button.tsx
new file mode 100644
index 0000000..9b8dca8
--- /dev/null
+++ b/src/components/features/assistant-button.tsx
@@ -0,0 +1,28 @@
+/**
+ * @file assistant-button.tsx
+ * @description Bouton flottant de l'assistant vak, présent sur tous les écrans du dashboard.
+ */
+
+"use client";
+
+import { AgentButton } from "@vak/agent/web";
+import { useLocale, useTranslations } from "next-intl";
+import { useRouter } from "@/i18n/navigation";
+import { vak } from "@/lib/vak";
+
+export function AssistantButton() {
+  const router = useRouter();
+  const lang = useLocale();
+  const t = useTranslations("nav");
+
+  return (
+    <AgentButton
+      {...vak}
+      label={t("assistant")}
+      lang={lang}
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push("/login")}
+      theme={{ accent: "#0F766E", mode: "system" }}
+    />
+  );
+}
