diff --git a/src/components/assistant/AssistantLauncher.tsx b/src/components/assistant/AssistantLauncher.tsx
new file mode 100644
index 0000000..99b164a
--- /dev/null
+++ b/src/components/assistant/AssistantLauncher.tsx
@@ -0,0 +1,37 @@
+'use client';
+
+import { AgentButton } from '@vak/agent/web';
+import { usePathname, useRouter } from 'next/navigation';
+import { useLocale } from 'next-intl';
+import { vak } from '@/lib/vak';
+
+// Écrans sans session (ou déjà occupés par le chat) : pas de bouton flottant.
+const HIDDEN_PREFIXES = [
+  '/login',
+  '/signup',
+  '/forgot-password',
+  '/reset-password',
+  '/verify-email',
+  '/join',
+  '/assistant',
+  '/offline',
+];
+
+export function AssistantLauncher() {
+  const pathname = usePathname();
+  const router = useRouter();
+  const lang = useLocale();
+
+  if (pathname === '/' || HIDDEN_PREFIXES.some((p) => pathname.startsWith(p))) return null;
+
+  return (
+    <AgentButton
+      {...vak}
+      label="Assistant"
+      lang={lang}
+      navigate={(href) => router.push(href)}
+      onUnauthorized={() => router.push('/login')}
+      theme={{ accent: '#0F766E', mode: 'system' }}
+    />
+  );
+}
