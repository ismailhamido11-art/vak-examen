@@ -0,0 +1,122 @@
+import { createClient, type SupabaseClient } from "@supabase/supabase-js";
+import { parseAction, type Proposal } from "./actions";
+
+// Tout passe par un client Supabase portant le jeton de l'utilisateur : la RLS
+// limite donc chaque lecture (et chaque écriture) à ses propres équipes.
+export function userClient(token: string): SupabaseClient {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const key = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
+  if (!url || !key) throw new Error("Variables Supabase manquantes");
+  return createClient(url, key, {
+    global: { headers: { Authorization: `Bearer ${token}` } },
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+}
+
+type Json = Record<string, unknown>;
+const LIMIT = 100;
+
+export const TOOLS = [
+  { name: "list_teams", description: "Équipes de l'utilisateur et son rôle dans chacune.", input_schema: { type: "object", properties: {} } },
+  { name: "list_members", description: "Membres (id, e-mail, rôle) d'une équipe.", input_schema: { type: "object", properties: { team_id: { type: "string" } }, required: ["team_id"] } },
+  { name: "list_sites", description: "Chantiers, éventuellement d'une seule équipe.", input_schema: { type: "object", properties: { team_id: { type: "string" } } } },
+  {
+    name: "list_tasks",
+    description: "Tâches, filtrables par chantier, par personne assignée (assignee_id, ou \"me\" pour l'utilisateur) et par état.",
+    input_schema: { type: "object", properties: { site_id: { type: "string" }, assignee_id: { type: "string" }, done: { type: "boolean" } } },
+  },
+  {
+    name: "propose_create_task",
+    description: "Propose de créer une tâche. Rien n'est écrit avant validation par l'utilisateur.",
+    input_schema: { type: "object", properties: { site_id: { type: "string" }, title: { type: "string" }, due_date: { type: "string", description: "AAAA-MM-JJ" }, assignee_id: { type: "string" } }, required: ["site_id", "title"] },
+  },
+  {
+    name: "propose_update_task",
+    description: "Propose de modifier une tâche (titre, échéance, fait, assigné ; null pour effacer l'échéance ou l'assigné).",
+    input_schema: { type: "object", properties: { task_id: { type: "string" }, title: { type: "string" }, due_date: { type: ["string", "null"] }, done: { type: "boolean" }, assignee_id: { type: ["string", "null"] } }, required: ["task_id"] },
+  },
+  { name: "propose_delete_task", description: "Propose de supprimer une tâche.", input_schema: { type: "object", properties: { task_id: { type: "string" } }, required: ["task_id"] } },
+  {
+    name: "propose_create_site",
+    description: "Propose de créer un chantier dans une équipe.",
+    input_schema: { type: "object", properties: { team_id: { type: "string" }, name: { type: "string" }, address: { type: "string" }, start_date: { type: "string" } }, required: ["team_id", "name"] },
+  },
+  {
+    name: "propose_update_site",
+    description: "Propose de modifier un chantier (nom, adresse, date de début, statut : planned, in_progress, on_hold, done).",
+    input_schema: { type: "object", properties: { site_id: { type: "string" }, name: { type: "string" }, address: { type: "string" }, start_date: { type: ["string", "null"] }, status: { type: "string" } }, required: ["site_id"] },
+  },
+];
+
+function must<T>(r: { data: T | null; error: { message: string } | null }): T {
+  if (r.error) throw new Error(r.error.message);
+  return r.data as T;
+}
+
+async function name(db: SupabaseClient, table: "tasks" | "sites" | "teams", col: "title" | "name", id: string) {
+  const row = must(await db.from(table).select(col).eq("id", id).maybeSingle()) as Record<string, string> | null;
+  if (!row) throw new Error("introuvable ou non accessible");
+  return row[col];
+}
+
+// Phrase lisible montrée à l'utilisateur ; vérifie au passage que les objets lui sont visibles.
+async function summarize(db: SupabaseClient, kind: string, a: Json): Promise<string> {
+  const s = a as Record<string, string | boolean | null | undefined>;
+  const changes = Object.entries(s)
+    .filter(([k]) => !["type", "task_id", "site_id", "team_id"].includes(k))
+    .map(([k, v]) => `${k} = ${v === null ? "∅" : JSON.stringify(v)}`)
+    .join(", ");
+  switch (kind) {
+    case "create_task":
+      return `Créer la tâche « ${s.title} » dans le chantier « ${await name(db, "sites", "name", s.site_id as string)} » (${changes.replace(/title = "[^"]*",? ?/, "") || "sans autre détail"})`;
+    case "update_task":
+      return `Modifier la tâche « ${await name(db, "tasks", "title", s.task_id as string)} » : ${changes}`;
+    case "delete_task":
+      return `Supprimer la tâche « ${await name(db, "tasks", "title", s.task_id as string)} »`;
+    case "create_site":
+      return `Créer le chantier « ${s.name} » dans l'équipe « ${await name(db, "teams", "name", s.team_id as string)} »`;
+    default:
+      return `Modifier le chantier « ${await name(db, "sites", "name", s.site_id as string)} » : ${changes}`;
+  }
+}
+
+export async function runTool(
+  db: SupabaseClient,
+  userId: string,
+  tool: string,
+  input: Json,
+  proposals: Proposal[],
+): Promise<unknown> {
+  if (tool.startsWith("propose_")) {
+    const action = parseAction(tool.slice("propose_".length), input);
+    const summary = await summarize(db, action.type, action);
+    const id = crypto.randomUUID();
+    proposals.push({ id, action, summary });
+    return "Proposition enregistrée ; l'utilisateur doit la valider avant toute modification. Ne dis pas que c'est fait.";
+  }
+  const opt = (k: string) => (typeof input[k] === "string" ? (input[k] as string) : undefined);
+  switch (tool) {
+    case "list_teams":
+      return must(await db.from("team_members").select("role, teams(id, name)").eq("user_id", userId).limit(LIMIT));
+    case "list_members": {
+      const id = opt("team_id");
+      if (!id) throw new Error("team_id requis");
+      return must(await db.rpc("team_roster", { p_team_id: id }));
+    }
+    case "list_sites": {
+      let q = db.from("sites").select("id, team_id, name, address, start_date, status").order("name").limit(LIMIT);
+      if (opt("team_id")) q = q.eq("team_id", opt("team_id")!);
+      return must(await q);
+    }
+    case "list_tasks": {
+      let q = db.from("tasks").select("id, site_id, title, due_date, done, assignee_id").order("due_date", { nullsFirst: false }).limit(LIMIT);
+      if (opt("site_id")) q = q.eq("site_id", opt("site_id")!);
+      const who = opt("assignee_id");
+      if (who) q = q.eq("assignee_id", who === "me" ? userId : who);
+      if (typeof input.done === "boolean") q = q.eq("done", input.done);
+      return must(await q);
+    }
+    default:
+      throw new Error(`outil inconnu : ${tool}`);
+  }
+}
