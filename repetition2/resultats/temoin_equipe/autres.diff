new file mode 100644
index 0000000..e526466
--- /dev/null
+++ b/src/components/Assistant.tsx
@@ -0,0 +1,107 @@
+"use client";
+
+import { useState } from "react";
+import { getSupabase } from "@/lib/supabase";
+import { applyAction, type Proposal } from "@/lib/assistant/actions";
+
+type Msg = { role: "user" | "assistant"; content: string };
+type Pending = Proposal & { state: "pending" | "done" | "refused" | "error"; error?: string };
+
+// Panneau de discussion. Les modifications proposées restent des cartes à valider :
+// elles ne sont exécutées (avec la session de l'utilisateur) qu'au clic sur « Valider ».
+export default function Assistant({ onChanged }: { onChanged: () => void }) {
+  const [open, setOpen] = useState(false);
+  const [msgs, setMsgs] = useState<Msg[]>([]);
+  const [pending, setPending] = useState<Pending[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function send(e: React.FormEvent) {
+    e.preventDefault();
+    const text = input.trim();
+    if (!text || busy) return;
+    const next = [...msgs, { role: "user" as const, content: text }];
+    setMsgs(next);
+    setInput("");
+    setBusy(true);
+    setError(null);
+    try {
+      const { data } = await getSupabase().auth.getSession();
+      if (!data.session) throw new Error("Session expirée.");
+      const res = await fetch("/api/assistant", {
+        method: "POST",
+        headers: { "content-type": "application/json", authorization: `Bearer ${data.session.access_token}` },
+        body: JSON.stringify({ messages: next }),
+      });
+      const body = await res.json();
+      if (!res.ok) throw new Error(body.error ?? "Erreur");
+      setMsgs([...next, { role: "assistant", content: body.reply || "(pas de réponse)" }]);
+      setPending((p) => [...p, ...(body.proposals as Proposal[]).map((x) => ({ ...x, state: "pending" as const }))]);
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function mark(id: string, patch: Partial<Pending>) {
+    setPending((p) => p.map((x) => (x.id === id ? { ...x, ...patch } : x)));
+  }
+
+  async function validate(p: Pending) {
+    mark(p.id, { state: "pending", error: undefined });
+    try {
+      await applyAction(getSupabase(), p.action);
+      mark(p.id, { state: "done" });
+      setMsgs((m) => [...m, { role: "user", content: `[Validé et appliqué : ${p.summary}]` }]);
+      onChanged();
+    } catch (err) {
+      mark(p.id, { state: "error", error: (err as Error).message });
+    }
+  }
+
+  function refuse(p: Pending) {
+    mark(p.id, { state: "refused" });
+    setMsgs((m) => [...m, { role: "user", content: `[Refusé : ${p.summary}]` }]);
+  }
+
+  if (!open) return <button className="assistant-toggle" onClick={() => setOpen(true)}>Assistant</button>;
+
+  return (
+    <aside className="assistant">
+      <div className="assistant-head">
+        <strong>Assistant</strong>
+        <button onClick={() => setOpen(false)}>Fermer</button>
+      </div>
+      <div className="assistant-log">
+        {msgs.length === 0 && <p className="muted">Demande par exemple : « Quelles sont mes tâches en retard ? »</p>}
+        {msgs.map((m, i) => (
+          <p key={i} className={m.role === "user" ? "muted" : ""}>
+            <strong>{m.role === "user" ? "Moi" : "Assistant"} : </strong>
+            {m.content}
+          </p>
+        ))}
+        {pending.map((p) => (
+          <div key={p.id} className="proposal">
+            <p>{p.summary}</p>
+            {p.state === "pending" || p.state === "error" ? (
+              <>
+                <button onClick={() => validate(p)}>Valider</button> <button onClick={() => refuse(p)}>Refuser</button>
+              </>
+            ) : (
+              <span className="muted">{p.state === "done" ? "Appliqué" : "Refusé"}</span>
+            )}
+            {p.error && <p className="error">{p.error}</p>}
+          </div>
+        ))}
+        {busy && <p className="muted">…</p>}
+        {error && <p className="error">{error}</p>}
+      </div>
+      <form onSubmit={send} className="assistant-form">
+        <input value={input} onChange={(e) => setInput(e.target.value)} placeholder="Ta demande…" maxLength={2000} />
+        <button disabled={busy}>Envoyer</button>
+      </form>
+    </aside>
+  );
+}
