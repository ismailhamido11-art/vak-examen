diff --git a/src/lib/assistant/actions.ts b/src/lib/assistant/actions.ts
new file mode 100644
index 0000000..af1ef4a
--- /dev/null
+++ b/src/lib/assistant/actions.ts
@@ -0,0 +1,138 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+// Écritures que l'assistant peut proposer. Rien n'est exécuté sans validation de
+// l'utilisateur ; l'exécution passe par son propre client Supabase, donc par la RLS.
+export type Action =
+  | { type: "create_task"; site_id: string; title: string; due_date?: string | null; assignee_id?: string | null }
+  | { type: "update_task"; task_id: string; title?: string; due_date?: string | null; done?: boolean; assignee_id?: string | null }
+  | { type: "delete_task"; task_id: string }
+  | { type: "create_site"; team_id: string; name: string; address?: string; start_date?: string | null }
+  | { type: "update_site"; site_id: string; name?: string; address?: string; start_date?: string | null; status?: string };
+
+export type Proposal = { id: string; action: Action; summary: string };
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const STATUSES = ["planned", "in_progress", "on_hold", "done"];
+
+type Obj = Record<string, unknown>;
+
+function uuid(o: Obj, k: string, required = true): string | null | undefined {
+  const v = o[k];
+  if (v === undefined || (v === null && !required)) return v as undefined | null;
+  if (typeof v !== "string" || !UUID.test(v)) throw new Error(`${k} : identifiant invalide`);
+  return v;
+}
+function text(o: Obj, k: string, required: boolean, max: number): string | undefined {
+  const v = o[k];
+  if (v === undefined) {
+    if (required) throw new Error(`${k} requis`);
+    return undefined;
+  }
+  if (typeof v !== "string" || v.length > max) throw new Error(`${k} : texte invalide`);
+  if (required && !v.trim()) throw new Error(`${k} requis`);
+  return v.trim();
+}
+function date(o: Obj, k: string): string | null | undefined {
+  const v = o[k];
+  if (v === undefined || v === null) return v as undefined | null;
+  if (typeof v !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(v) || Number.isNaN(Date.parse(v)))
+    throw new Error(`${k} : date AAAA-MM-JJ attendue`);
+  return v;
+}
+function bool(o: Obj, k: string): boolean | undefined {
+  const v = o[k];
+  if (v === undefined) return undefined;
+  if (typeof v !== "boolean") throw new Error(`${k} : booléen attendu`);
+  return v;
+}
+function defined<T extends Obj>(o: T): T {
+  return Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined)) as T;
+}
+
+// Ne garde que les champs connus, avec leur type ; lève une erreur sinon.
+export function parseAction(type: unknown, input: unknown): Action {
+  if (typeof input !== "object" || input === null) throw new Error("arguments invalides");
+  const o = input as Obj;
+  switch (type) {
+    case "create_task":
+      return defined({
+        type, site_id: uuid(o, "site_id") as string, title: text(o, "title", true, 200) as string,
+        due_date: date(o, "due_date"), assignee_id: uuid(o, "assignee_id", false),
+      });
+    case "update_task": {
+      const a = defined({
+        type, task_id: uuid(o, "task_id") as string, title: text(o, "title", false, 200),
+        due_date: date(o, "due_date"), done: bool(o, "done"), assignee_id: uuid(o, "assignee_id", false),
+      });
+      if (a.title === "") throw new Error("title vide");
+      if (Object.keys(a).length < 3) throw new Error("rien à modifier");
+      return a;
+    }
+    case "delete_task":
+      return { type, task_id: uuid(o, "task_id") as string };
+    case "create_site":
+      return defined({
+        type, team_id: uuid(o, "team_id") as string, name: text(o, "name", true, 200) as string,
+        address: text(o, "address", false, 300), start_date: date(o, "start_date"),
+      });
+    case "update_site": {
+      const status = text(o, "status", false, 20);
+      if (status !== undefined && !STATUSES.includes(status)) throw new Error("status invalide");
+      const a = defined({
+        type, site_id: uuid(o, "site_id") as string, name: text(o, "name", false, 200),
+        address: text(o, "address", false, 300), start_date: date(o, "start_date"), status,
+      });
+      if (a.name === "") throw new Error("name vide");
+      if (Object.keys(a).length < 3) throw new Error("rien à modifier");
+      return a;
+    }
+    default:
+      throw new Error(`action inconnue : ${String(type)}`);
+  }
+}
+
+// Exécute une action validée avec le client de l'utilisateur (la RLS décide).
+// Un UPDATE/DELETE refusé par la RLS ne lève pas d'erreur : on vérifie qu'une ligne a bougé.
+export async function applyAction(supabase: SupabaseClient, raw: Action): Promise<void> {
+  const { type, ...rest } = raw;
+  const a = parseAction(type, rest);
+  const fail = (e: { message: string } | null) => {
+    if (e) throw new Error(e.message);
+  };
+  const touched = (rows: unknown[] | null) => {
+    if (!rows?.length) throw new Error("Aucune ligne modifiée (introuvable ou non autorisé).");
+  };
+  switch (a.type) {
+    case "create_task": {
+      const { type: _t, ...row } = a;
+      void _t;
+      const { error } = await supabase.from("tasks").insert(row);
+      return fail(error);
+    }
+    case "update_task": {
+      const { type: _t, task_id, ...patch } = a;
+      void _t;
+      const { data, error } = await supabase.from("tasks").update(patch).eq("id", task_id).select("id");
+      fail(error);
+      return touched(data);
+    }
+    case "delete_task": {
+      const { data, error } = await supabase.from("tasks").delete().eq("id", a.task_id).select("id");
+      fail(error);
+      return touched(data);
+    }
+    case "create_site": {
+      const { type: _t, ...row } = a;
+      void _t;
+      const { error } = await supabase.from("sites").insert(row);
+      return fail(error);
+    }
+    case "update_site": {
+      const { type: _t, site_id, ...patch } = a;
+      void _t;
+      const { data, error } = await supabase.from("sites").update(patch).eq("id", site_id).select("id");
+      fail(error);
+      return touched(data);
+    }
+  }
+}
